{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "beaver": {
      "properties": {
        "coordination": {
          "properties": {
            "grace": {
              "type": "string"
            },
            "timeout": {
              "type": "string"
            }
          },
          "required": ["grace", "timeout"],
          "type": "object"
        },
        "debug": {
          "type": "boolean"
        },
        "howlite": {
          "properties": {
            "caldav": {
              "properties": {
                "calendar": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "path": {
                  "type": ["null", "string"]
                },
                "port": {
                  "type": ["integer", "null"]
                },
                "scheme": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                }
              },
              "required": ["calendar", "host", "password", "scheme", "user"],
              "type": "object"
            }
          },
          "required": ["caldav"],
          "type": "object"
        },
        "sapphire": {
          "properties": {
            "sql": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": ["host", "password", "port"],
              "type": "object"
            }
          },
          "required": ["sql"],
          "type": "object"
        },
        "server": {
          "properties": {
            "port": {
              "type": "integer"
            }
          },
          "required": ["port"],
          "type": "object"
        }
      },
      "required": ["coordination", "debug", "howlite", "sapphire", "server"],
      "type": "object"
    },
    "common": {
      "properties": {
        "metadata": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "configMap": {
      "properties": {
        "metadata": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "container": {
      "properties": {
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "deployment": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "pod": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "secret": {
      "properties": {
        "metadata": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "service": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "port": {
          "type": "integer"
        },
        "spec": {
          "type": "object"
        }
      },
      "required": ["port"],
      "type": "object"
    }
  },
  "required": ["beaver", "service"],
  "type": "object"
}
