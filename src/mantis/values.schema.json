{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "common": {
      "properties": {
        "metadata": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "configMap": {
      "properties": {
        "metadata": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "container": {
      "properties": {
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "mantis": {
      "properties": {
        "beaver": {
          "properties": {
            "http": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": ["null", "string"]
                },
                "port": {
                  "type": ["integer", "null"]
                },
                "scheme": {
                  "type": "string"
                }
              },
              "required": ["host", "scheme"],
              "type": "object"
            }
          },
          "required": ["http"],
          "type": "object"
        },
        "cleaner": {
          "properties": {
            "interval": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            }
          },
          "required": ["interval", "reference"],
          "type": "object"
        },
        "debug": {
          "type": "boolean"
        },
        "gecko": {
          "properties": {
            "http": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": ["null", "string"]
                },
                "port": {
                  "type": ["integer", "null"]
                },
                "scheme": {
                  "type": "string"
                }
              },
              "required": ["host", "scheme"],
              "type": "object"
            }
          },
          "required": ["http"],
          "type": "object"
        },
        "numbat": {
          "properties": {
            "http": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": ["null", "string"]
                },
                "port": {
                  "type": ["integer", "null"]
                },
                "scheme": {
                  "type": "string"
                }
              },
              "required": ["host", "scheme"],
              "type": "object"
            }
          },
          "required": ["http"],
          "type": "object"
        },
        "octopus": {
          "properties": {
            "http": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": ["null", "string"]
                },
                "port": {
                  "type": ["integer", "null"]
                },
                "scheme": {
                  "type": "string"
                }
              },
              "required": ["host", "scheme"],
              "type": "object"
            },
            "srt": {
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": ["host", "port"],
              "type": "object"
            }
          },
          "required": ["http", "srt"],
          "type": "object"
        },
        "operations": {
          "properties": {
            "stream": {
              "properties": {
                "latency": {
                  "type": "string"
                },
                "linger": {
                  "type": "string"
                },
                "ogg": {
                  "properties": {
                    "page": {
                      "type": "string"
                    }
                  },
                  "required": ["page"],
                  "type": "object"
                },
                "timeout": {
                  "type": "string"
                },
                "window": {
                  "type": "string"
                }
              },
              "required": ["latency", "linger", "ogg", "timeout", "window"],
              "type": "object"
            }
          },
          "required": ["stream"],
          "type": "object"
        },
        "server": {
          "properties": {
            "port": {
              "type": "integer"
            }
          },
          "required": ["port"],
          "type": "object"
        },
        "synchronizer": {
          "properties": {
            "interval": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "synchronizers": {
              "properties": {
                "stream": {
                  "properties": {
                    "window": {
                      "type": "string"
                    }
                  },
                  "required": ["window"],
                  "type": "object"
                }
              },
              "required": ["stream"],
              "type": "object"
            }
          },
          "required": ["interval", "reference", "synchronizers"],
          "type": "object"
        }
      },
      "required": [
        "beaver",
        "cleaner",
        "debug",
        "gecko",
        "numbat",
        "octopus",
        "operations",
        "server",
        "synchronizer"
      ],
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "pod": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "service": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "port": {
          "type": "integer"
        },
        "spec": {
          "type": "object"
        }
      },
      "required": ["port"],
      "type": "object"
    },
    "statefulSet": {
      "properties": {
        "metadata": {
          "type": "object"
        },
        "spec": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "volume": {
      "properties": {
        "access": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "class": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "size": {
          "type": "string"
        },
        "spec": {
          "type": "object"
        }
      },
      "required": ["access", "size"],
      "type": "object"
    }
  },
  "required": ["mantis", "service"],
  "type": "object"
}
